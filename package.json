{
  "name": "@elumixor/devkit",
  "version": "0.12.10",
  "description": "Dev orchestrator for bun monorepos — free ports, run apps side-by-side, open the browser when ready",
  "author": "elumixor",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elumixor/devkit.git"
  },
  "bin": {
    "devkit": "src/bin/devkit.ts",
    "free-port": "src/bin/free-port.ts"
  },
  "exports": {
    "./runtime": "./src/runtime/index.ts",
    "./blob": "./src/blob/index.ts",
    "./package.json": "./package.json",
    "./cloud": "./src/cloud/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "release": "npm version patch -m \"Release v%s\" && git push --follow-tags",
    "release:patch": "npm version patch -m \"Release v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Release v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"Release v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1161.0",
    "@aws-sdk/client-budgets": "^3.1161.0",
    "@aws-sdk/client-cloudfront": "^3.1161.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1161.0",
    "@aws-sdk/client-cloudwatch": "^3.1161.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1161.0",
    "@aws-sdk/client-cost-explorer": "^3.1161.0",
    "@aws-sdk/client-iam": "^3.1161.0",
    "@aws-sdk/client-lambda": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-scheduler": "^3.1161.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@aws-sdk/client-sts": "^3.1161.0",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@smithy/signature-v4a": "^3.6.2",
    "ink": "7.1.1",
    "react": "19.2.8",
    "wrap-ansi": "10.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "typescript": "^5"
  }
}
